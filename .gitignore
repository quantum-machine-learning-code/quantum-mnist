# Virtual environment
.venv/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]

# Test and tooling caches
.pytest_cache/

# Run artifacts: metrics JSON, plots and generated text are regenerated by experiments
results/

# Local dataset cache (downloaded MNIST / openml / synthetic dumps)
data/

# Distribution / packaging metadata
*.egg-info/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# macOS metadata
.DS_Store

# Generated figures (exp1_*.png / exp2_*.png) live under results/, so those
# images are ignored by default through the results/ rule above.
# Ignore loose PNGs elsewhere too, but keep committed docs/assets images:
*.png
!docs/**/*.png
!assets/**/*.png
